# Export these variables in your shell; this file is documentation, not autoloaded.
# Optional LLM drafting. The reported offline agent needs no API.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Independent LLM judge. Chat Completions HTTPS. Example: AgentRouter.
JUDGE_BASE_URL=https://agentrouter.org/v1
JUDGE_MODEL=deepseek-v4-flash
JUDGE_API_KEY=
# AgentRouter requires this client User-Agent; urllib's default is rejected.
JUDGE_USER_AGENT=QwenCode/0.2.0 (linux; x64)
# Tried in order after the primary model if a quoted tweet is content-blocked.
JUDGE_FALLBACK_MODELS=glm-5.3,gpt-5.6-sol

